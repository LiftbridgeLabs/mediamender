# mediaWarden configuration example
# Copy this to config.yml and edit to match your setup.
# The setup wizard at http://YOUR_IP:8222 can generate this for you.

# Disable modules you do not use. Disabled modules are hidden from the UI and
# their scheduled/manual operations are blocked.
features:
  trash_removal: true
  metadata_health: true
  timestamp_repair: true
  library_refresh: true
  mark_watched: true

# Future Sonarr Download imports can be marked watched after Plex matches them.
# Connect Sonarr in Settings to generate this automatically, or prefer the
# MEDIAMENDER_SONARR_WEBHOOK_SECRET environment override.
mark_watched:
  webhook_secret: ""
  # How long to keep re-checking Plex for a newly imported episode. Sonarr
  # reports an import the moment the file lands, which for a symlinked debrid
  # library is well before Plex has scanned it. These delays span about an hour.
  retry_delays: [15, 30, 60, 120, 300, 600, 900, 1200]
  # Ask Plex to scan the imported folder while waiting, instead of only polling.
  scan_on_import: true
  # Background workers that process queued imports. More workers stop one
  # import waiting on a Plex scan from blocking every later webhook.
  workers: 4
  # Omit visible_libraries to show all configured TV libraries. An explicit
  # empty list hides all libraries; Settings can manage this list safely.
  # visible_libraries:
  #   - "My Plex::TV Shows"

discord_webhook: https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

log_level: INFO
logging:
  max_file_size_mb: 5   # rotate the active file when it reaches this size
  max_total_size_mb: 50 # cap all active and rotated logs combined
  retention_days: 14    # remove rotated logs older than this

notify:
  on_emptied: true       # notify when trash was actually emptied
  on_health_fail: true   # notify when health checks failed and empty was skipped
  on_error: true         # notify when emptyTrash API call failed
  on_clean: false        # notify when run succeeded but trash was already empty (noisy)
  on_skip: false         # notify when run was skipped (scheduling paused, config error)

# Optional Apprise destinations. Add and test these more easily in Settings.
# The URL contains credentials; protect config.yml and never share it.
notifications:
  destinations:
    - name: Telegram alerts
      service: telegram
      url: tgram://BOT_TOKEN/CHAT_ID
      enabled: true
      events:
        - emptied
        - health_fail
        - error
    # Other examples:
    # ntfy://ntfy.sh/mediawarden-topic
    # gotify://gotify.example.com/APP_TOKEN
    # mailtos://USER:PASSWORD@SMTP_HOST
    # pover://USER_KEY@APP_TOKEN
    # json://webhook.example.com/path

# Optional server-wide maintenance action. Disabled by default because it has
# broader scope than a single library's Empty Trash request.
clean_bundles_before_empty: false

# Abort if a trash snapshot exceeds either limit. Set a limit to 0 to disable it.
max_trash_items: 1000
max_trash_percent: 25

# Libraries without their own cron value inherit this global schedule.
# The first automatic run is the next matching clock time after startup.
schedule:
  default_cron: "0 * * * *"  # every hour on the hour

# Optional: set username/password to protect the web UI
# Leave out to disable auth (fine for trusted local networks)
# Or configure via Settings → Security in the UI
auth:
  username: admin
  # Additional admin/user accounts and page permissions are managed in Settings.
  # users: []
  # API token hashes are managed automatically; generate tokens in Settings.
  password_hash: ""  # set via Settings UI — never enter plaintext here

# Optional: debrid provider API keys for health checks
# Can also be set as env vars: RD_API_KEY, AD_API_KEY, TB_API_KEY, DL_API_KEY
# Or configure via Settings → Providers in the UI
# providers:
#   realdebrid:
#     api_key: YOUR_RD_API_KEY

# Optional repair-only worker on another Plex machine. Normally created from
# Settings -> Timestamp Repair; the worker receives no Plex token.
# timestamp_repair_workers:
#   - name: altmount-worker
#     url: http://vm-altmount:8223
#     controller_url: http://unraid-host:8222
#     token: generate-a-random-secret-of-at-least-32-characters

plex_instances:
  # Physical media server example
  - name: My Plex
    url: http://192.168.1.100:32400
    token: ""  # set via PLEX_TOKEN_MY_PLEX env var, or paste in Settings UI
    # Optional: exclude libraries that intentionally use local-only metadata.
    metadata_health:
      ignored_libraries:
        - Youtube
    # Optional, manual-only repair for Plex parts with negative timestamps.
    # The database directory must be mounted read-only. Each allowed prefix
    # must be a narrow library-facing symlink tree mounted read/write.
    timestamp_repair:
      enabled: false
      worker: local  # or the name of a timestamp_repair_workers entry
      database_path: /plex-db/com.plexapp.plugins.library.db
      allowed_prefixes:
        - /mnt/symlink_media/symlinks/repair
      max_files_per_folder: 5
      scan_timeout_seconds: 1800
      poll_interval_seconds: 5
      heartbeat_seconds: 30
    libraries:
      - name: Movies
        type: physical
        # No cron: inherits schedule.default_cron
        paths:
          - path: /mnt/user/media/movies
            type: physical
            min_threshold: 90  # 90% of Plex count must exist on disk

      - name: TV Shows
        type: physical
        paths:
          - path: /mnt/user/media/tv
            type: physical
            min_threshold: 90

      - name: Sports
        type: physical
        cron: "*/30 * * * *"  # optional per-library override
        # Optional independent Plex library refresh schedule.
        refresh_enabled: true
        refresh_cron: "0 * * * *"
        refresh_guard_minutes: 15
        paths:
          - path: /mnt/user/media/sports
            type: physical
            min_threshold: 50  # lower threshold for small/growing libraries

  # Debrid media server example
  - name: My Plex Unlimited
    url: http://192.168.1.100:32410
    token: ""  # set via PLEX_TOKEN_MY_PLEX_UNLIMITED env var
    libraries:
      # Mixed library — physical usenet + debrid symlinks in same Plex library
      # threshold check combines all paths vs total Plex count
      - name: Movies
        type: mixed
        cron: "*/30 * * * *"  # every 30 minutes
        paths:
          - path: /mnt/user/media/movies
            type: physical
            min_threshold: 90
          - path: /symlink_media/symlinks/radarr
            type: debrid
            min_threshold: 90
            provider_checks:
              - type: realdebrid
                api_key: ""  # uses RD_API_KEY env var or providers block above

      # Pure debrid library
      - name: TV Shows
        type: debrid
        cron: "*/30 * * * *"
        paths:
          - path: /symlink_media/symlinks/sonarr
            type: debrid
            min_threshold: 90
            provider_checks:
              - type: realdebrid
                api_key: ""
