# Copy to .env and fill in your values.
# .env is gitignored — never commit it.
# On Unraid set these in the Docker UI instead.

# ── Plex tokens ───────────────────────────────────────────────────────────────
# One per instance, named after the instance name in the wizard:
# uppercased, spaces/hyphens → underscores, prefixed PLEX_TOKEN_
# Example: "My Plex" → PLEX_TOKEN_MY_PLEX=xxxxx
PLEX_TOKEN_MY_INSTANCE=your_plex_token_here
# PLEX_TOKEN_MY_OTHER_INSTANCE=your_other_token_here

# ── Debrid provider API keys (optional) ───────────────────────────────────────
RD_API_KEY=your_realdebrid_api_key
# AD_API_KEY=your_alldebrid_api_key
# TB_API_KEY=your_torbox_api_key
# DL_API_KEY=your_debridlink_api_key

# ── Web UI auth (optional) ────────────────────────────────────────────────────
# If set, the web UI requires username/password login.
# Leave blank to disable auth.
# MEDIAMENDER_USERNAME=admin
# MEDIAMENDER_PASSWORD=changeme

# Dedicated authentication for POST /api/webhooks/sonarr. Settings can generate
# and configure this automatically; set it here to manage the secret externally.
# MEDIAMENDER_SONARR_WEBHOOK_SECRET=generate-a-long-random-secret

# Sonarr API key. Optional — the Connect form accepts one directly — but setting it here lets
# connecting and removing work without retyping it, and is the only way removing a connection can
# also delete its webhook from Sonarr when you no longer have the key to hand.
# SONARR_API_KEY=your-sonarr-api-key

# ── Notifications ─────────────────────────────────────────────────────────────
DISCORD_WEBHOOK=https://discord.com/api/webhooks/your/webhook

# ── Other ─────────────────────────────────────────────────────────────────────
PUID=99
PGID=100
TZ=America/New_York
# LOG_LEVEL=INFO
# MEDIAMENDER_SECRET_KEY=  # Set to a stable random value (e.g. `openssl rand -hex 32`)
#                       # Without this, sessions are invalidated on every container restart.
# BROWSE_ROOTS=/mnt,/media,/data,/home  # Comma-separated list of roots the file browser may enter
# FLASK_HOST=127.0.0.1                  # Set to 0.0.0.0 for external access or reverse proxy use
# SESSION_COOKIE_SECURE=false           # Set to true when serving over HTTPS (reverse proxy)
